{
  "scene_id": "初次约会",
  "scene_name": "初次约会",
  "version": "2.0",
  "scripts": [
    {
      "id": "ch_001",
      "round": 1,
      "purpose": "见面问候-轻松型",
      "user_emotion": ["紧张", "开心"],
      "coach_style": ["鼓励型", "支持型"],
      "level": "轻松型",
      "text": "终于见面了！比照片上感觉更亲切呢，今天天气真不错，看来我们运气挺好的。",
      "tags": ["见面问候", "赞美", "轻松氛围"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_002",
      "round": 1,
      "purpose": "见面问候-幽默型",
      "user_emotion": ["紧张", "期待"],
      "coach_style": ["挑战型"],
      "level": "幽默型",
      "text": "你好，很高兴见到你！过来还顺利吗？我们先看看坐哪里舒服。",
      "tags": ["见面问候", "关心", "轻松氛围"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_003",
      "round": 2,
      "purpose": "选择座位-贴心型",
      "user_emotion": ["平静"],
      "coach_style": ["支持型"],
      "level": "贴心型",
      "text": "靠窗和里面的位置都空着，你更喜欢坐哪边？如果觉得冷，我们也可以换个位置。",
      "tags": ["选择座位", "贴心", "观察细致"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_004",
      "round": 2,
      "purpose": "推荐菜品-专业型",
      "user_emotion": ["自信"],
      "coach_style": ["挑战型"],
      "level": "主导型",
      "text": "听说这里的招牌菜不错。你有什么忌口或偏好吗？我们一起看看再点。",
      "tags": ["推荐菜品", "主导", "展现细心"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_005",
      "round": 3,
      "purpose": "展开话题-兴趣型",
      "user_emotion": ["感兴趣"],
      "coach_style": ["鼓励型"],
      "level": "引导型",
      "text": "我看你朋友圈上次发了去看展的照片，那个展我也很感兴趣！你平时是不是经常逛展览？最喜欢哪种类型的？",
      "tags": ["展开话题", "朋友圈切入", "开放式提问"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_006",
      "round": 3,
      "purpose": "展开话题-共鸣型",
      "user_emotion": ["平静", "感兴趣"],
      "coach_style": ["分析型"],
      "level": "共鸣型",
      "text": "你刚才说的那一点我也有类似感受。我之前遇到的是[简短真实经历]，不过你的经历可能不一样，你当时是怎么想的？",
      "tags": ["展开话题", "真实共鸣", "开放式提问"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_007",
      "round": 4,
      "purpose": "分享自己-引导互动",
      "user_emotion": ["平静"],
      "coach_style": ["支持型"],
      "level": "互动型",
      "text": "我最近在尝试学做手冲咖啡，虽然还在入门阶段，但发现自己对味道挺敏感的。你呢？有没有什么最近在尝试的新东西？",
      "tags": ["分享自己", "引导互动", "展现生活情趣"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_008",
      "round": 4,
      "purpose": "分享自己-展现特色",
      "user_emotion": ["自信"],
      "coach_style": ["挑战型"],
      "level": "特色型",
      "text": "我有个爱好是周末去菜市场闲逛，听那些阿姨们聊天特别有意思，而且总能发现一些新奇的食材。听起来有点奇怪对吧？但真的很解压！",
      "tags": ["分享自己", "展现特色", "制造反差萌"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_009",
      "round": 5,
      "purpose": "表达欣赏-具体型",
      "user_emotion": ["开心"],
      "coach_style": ["支持型"],
      "level": "具体型",
      "text": "刚才你讲旅行时提到会认真记录当地人的生活，我觉得这个观察很细致，听着也很有画面感。",
      "tags": ["表达欣赏", "具体细节", "真诚赞美"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_010",
      "round": 5,
      "purpose": "表达欣赏-感觉型",
      "user_emotion": ["开心", "期待"],
      "coach_style": ["鼓励型"],
      "level": "感觉型",
      "text": "跟你聊天真的特别舒服，时间过得好快，我刚才差点想说'这么快就吃完了？'，有点意犹未尽的感觉。",
      "tags": ["表达欣赏", "感觉表达", "暗示好感"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_011",
      "round": 6,
      "purpose": "试探心意-直接型",
      "user_emotion": ["紧张", "期待"],
      "coach_style": ["支持型"],
      "level": "直接型",
      "text": "今天聊得挺开心的。我对你多了解了一些，也想听听你今天的感受，不方便现在说也没关系。",
      "tags": ["试探心意", "直接询问", "展现真诚"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_012",
      "round": 6,
      "purpose": "试探心意-暗示型",
      "user_emotion": ["期待"],
      "coach_style": ["挑战型"],
      "level": "暗示型",
      "text": "我觉得今天特别投缘，感觉有说不完的话。你说我们要是多接触几次，会不会发现更多共同点？我挺期待的。",
      "tags": ["试探心意", "暗示", "表达好感"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_013",
      "round": 7,
      "purpose": "收尾邀约-具体型",
      "user_emotion": ["开心", "期待"],
      "coach_style": ["支持型"],
      "level": "具体型",
      "text": "今天聊得很愉快。你刚才提到喜欢展览，如果你也愿意继续联系，我们可以加个联系方式；不方便也没关系。",
      "tags": ["收尾邀约", "具体活动", "自然留联系方式"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_014",
      "round": 7,
      "purpose": "收尾邀约-轻松型",
      "user_emotion": ["平静", "开心"],
      "coach_style": ["挑战型"],
      "level": "轻松型",
      "text": "时间过得真快。你说的那家咖啡店听起来不错，如果我们都想再见面，下次可以一起去。",
      "tags": ["收尾邀约", "轻松自然", "约定下次见面"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_015",
      "round": 2,
      "purpose": "应对冷场-幽默解围",
      "user_emotion": ["尴尬"],
      "coach_style": ["鼓励型"],
      "level": "幽默型",
      "text": "刚才聊了不少，安静一会儿也挺自然的。这个菜看起来不错，你觉得味道怎么样？",
      "tags": ["应对冷场", "幽默解围", "转移话题"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_016",
      "round": 3,
      "purpose": "化解尴尬-坦诚型",
      "user_emotion": ["尴尬"],
      "coach_style": ["支持型"],
      "level": "坦诚型",
      "text": "其实我刚才有点紧张，可能说得不太顺。我们不用急，按舒服的节奏聊就好。",
      "tags": ["化解尴尬", "坦诚", "拉近距离"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_017",
      "round": 4,
      "purpose": "回应赞美-谦虚型",
      "user_emotion": ["开心"],
      "coach_style": ["鼓励型"],
      "level": "谦虚型",
      "text": "谢谢夸奖！不过我觉得你也很有意思啊，跟你聊天才发现原来有人跟我一样喜欢XX。",
      "tags": ["回应赞美", "谦虚", "回赞"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_018",
      "round": 5,
      "purpose": "建立共鸣-发现共同点",
      "user_emotion": ["感兴趣", "开心"],
      "coach_style": ["支持型"],
      "level": "共鸣型",
      "text": "哇，原来你也喜欢XX！这个真的不多见。我之前还以为这个爱好很小众呢，没想到遇到同好了！我们可以多聊聊这个。",
      "tags": ["建立共鸣", "发现共同点", "加深连接"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_019",
      "round": 6,
      "purpose": "深入了解-价值观型",
      "user_emotion": ["期待"],
      "coach_style": ["分析型"],
      "level": "深度型",
      "text": "聊了这么多，我想问一个稍微深入一点的问题：你对未来有什么期待吗？就是那种，你觉得什么样的生活状态是理想的？",
      "tags": ["深入了解", "价值观探讨", "深度交流"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_020",
      "round": 7,
      "purpose": "礼貌告别-期待型",
      "user_emotion": ["开心", "期待"],
      "coach_style": ["鼓励型"],
      "level": "期待型",
      "text": "今天谢谢你陪我度过了一个很愉快的下午/晚上！期待下次见面，你回去路上注意安全哦。",
      "tags": ["礼貌告别", "表达感谢", "期待下次"],
      "usage_count": 0,
      "rating": 0
    }
  ]
}
