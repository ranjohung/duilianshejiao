{
  "scene_id": "初次约会",
  "scene_name": "初次约会",
  "version": "2.0",
  "scripts": [
    {
      "id": "ch_001",
      "round": 1,
      "purpose": "见面问候-轻松型",
      "user_emotion": ["紧张", "开心"],
      "coach_style": ["鼓励型", "支持型"],
      "level": "轻松型",
      "text": "终于见面了！比照片上感觉更亲切呢，今天天气真不错，看来我们运气挺好的。",
      "tags": ["见面问候", "赞美", "轻松氛围"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_002",
      "round": 1,
      "purpose": "见面问候-幽默型",
      "user_emotion": ["紧张", "期待"],
      "coach_style": ["挑战型"],
      "level": "幽默型",
      "text": "你好呀！我刚才在想，要是见到你本人和照片不一样怎么办？现在看来是更好看了，赚到了！",
      "tags": ["见面问候", "幽默", "制造惊喜"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_003",
      "round": 2,
      "purpose": "选择座位-贴心型",
      "user_emotion": ["平静"],
      "coach_style": ["支持型"],
      "level": "贴心型",
      "text": "这边靠窗的位置光线好一些，而且风也小，我们坐这儿吧？你看起来有点怕冷，这个位置比较合适。",
      "tags": ["选择座位", "贴心", "观察细致"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_004",
      "round": 2,
      "purpose": "推荐菜品-专业型",
      "user_emotion": ["自信"],
      "coach_style": ["挑战型"],
      "level": "主导型",
      "text": "这家店我做过功课，他们家的招牌菜是XX，评价很好。而且这个季节的时令菜XX也很不错，要不要试试？我帮你点一个？",
      "tags": ["推荐菜品", "主导", "展现细心"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_005",
      "round": 3,
      "purpose": "展开话题-兴趣型",
      "user_emotion": ["感兴趣"],
      "coach_style": ["鼓励型"],
      "level": "引导型",
      "text": "我看你朋友圈上次发了去看展的照片，那个展我也很感兴趣！你平时是不是经常逛展览？最喜欢哪种类型的？",
      "tags": ["展开话题", "朋友圈切入", "开放式提问"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_006",
      "round": 3,
      "purpose": "展开话题-共鸣型",
      "user_emotion": ["平静", "感兴趣"],
      "coach_style": ["分析型"],
      "level": "共鸣型",
      "text": "你说的那个想法我特别认同！其实我之前也想过类似的事情，后来发现...哎，我们怎么聊到一块儿去了，感觉像认识很久似的。",
      "tags": ["展开话题", "制造共鸣", "拉近距离"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_007",
      "round": 4,
      "purpose": "分享自己-引导互动",
      "user_emotion": ["平静"],
      "coach_style": ["支持型"],
      "level": "互动型",
      "text": "我最近在尝试学做手冲咖啡，虽然还在入门阶段，但发现自己对味道挺敏感的。你呢？有没有什么最近在尝试的新东西？",
      "tags": ["分享自己", "引导互动", "展现生活情趣"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_008",
      "round": 4,
      "purpose": "分享自己-展现特色",
      "user_emotion": ["自信"],
      "coach_style": ["挑战型"],
      "level": "特色型",
      "text": "我有个爱好是周末去菜市场闲逛，听那些阿姨们聊天特别有意思，而且总能发现一些新奇的食材。听起来有点奇怪对吧？但真的很解压！",
      "tags": ["分享自己", "展现特色", "制造反差萌"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_009",
      "round": 5,
      "purpose": "表达欣赏-具体型",
      "user_emotion": ["开心"],
      "coach_style": ["支持型"],
      "level": "具体型",
      "text": "我发现你聊天的时候特别真诚，不像有些人聊天很敷衍。刚才你说那段关于旅行的经历，能感觉到你是真的热爱生活，这种感染力特别好。",
      "tags": ["表达欣赏", "具体细节", "真诚赞美"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_010",
      "round": 5,
      "purpose": "表达欣赏-感觉型",
      "user_emotion": ["开心", "期待"],
      "coach_style": ["鼓励型"],
      "level": "感觉型",
      "text": "跟你聊天真的特别舒服，时间过得好快，我刚才差点想说'这么快就吃完了？'，有点意犹未尽的感觉。",
      "tags": ["表达欣赏", "感觉表达", "暗示好感"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_011",
      "round": 6,
      "purpose": "试探心意-直接型",
      "user_emotion": ["紧张", "期待"],
      "coach_style": ["支持型"],
      "level": "直接型",
      "text": "今天跟你聊得特别开心，我想问问...你对我的印象怎么样？就是那种...真实的感觉。",
      "tags": ["试探心意", "直接询问", "展现真诚"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_012",
      "round": 6,
      "purpose": "试探心意-暗示型",
      "user_emotion": ["期待"],
      "coach_style": ["挑战型"],
      "level": "暗示型",
      "text": "我觉得今天特别投缘，感觉有说不完的话。你说我们要是多接触几次，会不会发现更多共同点？我挺期待的。",
      "tags": ["试探心意", "暗示", "表达好感"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_013",
      "round": 7,
      "purpose": "收尾邀约-具体型",
      "user_emotion": ["开心", "期待"],
      "coach_style": ["支持型"],
      "level": "具体型",
      "text": "今天聊得特别愉快！对了，我知道下个月有个XX展览，感觉你应该会感兴趣。要不要留个联系方式？到时候我把信息发你，我们可以一起去看。",
      "tags": ["收尾邀约", "具体活动", "自然留联系方式"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_014",
      "round": 7,
      "purpose": "收尾邀约-轻松型",
      "user_emotion": ["平静", "开心"],
      "coach_style": ["挑战型"],
      "level": "轻松型",
      "text": "时间过得真快！加个微信吧，以后多联系。说好了啊，下次见面我要听你推荐的那家咖啡店，你得带路。",
      "tags": ["收尾邀约", "轻松自然", "约定下次见面"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_015",
      "round": 2,
      "purpose": "应对冷场-幽默解围",
      "user_emotion": ["尴尬"],
      "coach_style": ["鼓励型"],
      "level": "幽默型",
      "text": "哎，好像突然安静了...这个菜上来了，看起来不错！你尝尝这个，我刚才闻着感觉挺香的。",
      "tags": ["应对冷场", "幽默解围", "转移话题"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_016",
      "round": 3,
      "purpose": "化解尴尬-坦诚型",
      "user_emotion": ["尴尬"],
      "coach_style": ["支持型"],
      "level": "坦诚型",
      "text": "其实我刚才有点紧张，好久没跟人这么认真地聊天了。你别介意哈，咱们就当朋友随便聊就好。",
      "tags": ["化解尴尬", "坦诚", "拉近距离"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_017",
      "round": 4,
      "purpose": "回应赞美-谦虚型",
      "user_emotion": ["开心"],
      "coach_style": ["鼓励型"],
      "level": "谦虚型",
      "text": "谢谢夸奖！不过我觉得你也很有意思啊，跟你聊天才发现原来有人跟我一样喜欢XX。",
      "tags": ["回应赞美", "谦虚", "回赞"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_018",
      "round": 5,
      "purpose": "建立共鸣-发现共同点",
      "user_emotion": ["感兴趣", "开心"],
      "coach_style": ["支持型"],
      "level": "共鸣型",
      "text": "哇，原来你也喜欢XX！这个真的不多见。我之前还以为这个爱好很小众呢，没想到遇到同好了！我们可以多聊聊这个。",
      "tags": ["建立共鸣", "发现共同点", "加深连接"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_019",
      "round": 6,
      "purpose": "深入了解-价值观型",
      "user_emotion": ["期待"],
      "coach_style": ["分析型"],
      "level": "深度型",
      "text": "聊了这么多，我想问一个稍微深入一点的问题：你对未来有什么期待吗？就是那种，你觉得什么样的生活状态是理想的？",
      "tags": ["深入了解", "价值观探讨", "深度交流"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "ch_020",
      "round": 7,
      "purpose": "礼貌告别-期待型",
      "user_emotion": ["开心", "期待"],
      "coach_style": ["鼓励型"],
      "level": "期待型",
      "text": "今天谢谢你陪我度过了一个很愉快的下午/晚上！期待下次见面，你回去路上注意安全哦。",
      "tags": ["礼貌告别", "表达感谢", "期待下次"],
      "usage_count": 0,
      "rating": 0
    }
  ]
}
