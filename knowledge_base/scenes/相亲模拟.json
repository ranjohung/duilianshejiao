  "version": "2.0",
  "scripts": [
    {
      "id": "xq_001",
      "round": 1,
      "purpose": "破冰开场-轻松型",
      "user_emotion": ["紧张", "期待"],
      "coach_style": ["鼓励型", "支持型"],
      "level": "轻松型",
      "text": "你好！我是XX介绍的，今天终于见面了。路上还在想会不会尴尬，现在看到你感觉安心多了。",
      "tags": ["破冰开场", "自嘲化解紧张", "表达好感"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_002",
      "round": 1,
      "purpose": "破冰开场-幽默型",
      "user_emotion": ["紧张"],
      "coach_style": ["挑战型"],
      "level": "幽默型",
      "text": "你好！说实话我是被我妈逼着来的，不过现在看来得感谢她了。你比照片上好看多了，照片是不是P过的？哈哈哈开玩笑的。",
      "tags": ["破冰开场", "幽默自嘲", "制造轻松氛围"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_003",
      "round": 1,
      "purpose": "破冰开场-真诚型",
      "user_emotion": ["紧张", "期待"],
      "coach_style": ["鼓励型"],
      "level": "真诚型",
      "text": "你好，很高兴认识你！其实我挺紧张的，好久没相过亲了。不过看起来你也是，那我们就当认识新朋友，随便聊聊就好。",
      "tags": ["破冰开场", "坦诚紧张", "拉平心态"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_004",
      "round": 1,
      "purpose": "破冰开场-赞美型",
      "user_emotion": ["期待"],
      "coach_style": ["支持型"],
      "level": "赞美型",
      "text": "终于见面了！XX经常跟我提起你，说你特别有意思，今天一见果然名不虚传。",
      "tags": ["破冰开场", "第三方赞美", "建立好感"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_005",
      "round": 2,
      "purpose": "展开话题-工作切入",
      "user_emotion": ["平静", "感兴趣"],
      "coach_style": ["分析型"],
      "level": "自然型",
      "text": "听XX说你是做XX的？这个行业我不太了解，但感觉挺有意思的。能跟我聊聊你平时主要做什么吗？",
      "tags": ["展开话题", "工作切入", "开放式提问"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_006",
      "round": 2,
      "purpose": "展开话题-兴趣切入",
      "user_emotion": ["感兴趣"],
      "coach_style": ["鼓励型"],
      "level": "兴趣型",
      "text": "你平时周末一般喜欢做什么呀？是喜欢宅家里还是出去逛逛？我感觉你的性格应该挺有意思的。",
      "tags": ["展开话题", "兴趣爱好", "试探性格"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_007",
      "round": 2,
      "purpose": "展开话题-观察切入",
      "user_emotion": ["平静"],
      "coach_style": ["挑战型"],
      "level": "观察型",
      "text": "我注意到你戴了XX，这个牌子我知道，挺有品味的。你是一直关注这个还是最近才喜欢上的？",
      "tags": ["展开话题", "细致观察", "赞美品味"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_008",
      "round": 3,
      "purpose": "建立共鸣-发现共同点",
      "user_emotion": ["感兴趣", "开心"],
      "coach_style": ["支持型"],
      "level": "共鸣型",
      "text": "哇，原来你也喜欢XX！这个真的不多见，我身边朋友很少有喜欢这个的。看来我们挺有缘分的，能遇到同好。",
      "tags": ["建立共鸣", "发现共同点", "强化连接"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_009",
      "round": 3,
      "purpose": "建立共鸣-认同观点",
      "user_emotion": ["平静"],
      "coach_style": ["分析型"],
      "level": "认同型",
      "text": "你刚才说的那个想法我特别认同！其实很多人都不会这么想，看来我们的价值观挺像的。这种感觉挺奇妙的。",
      "tags": ["建立共鸣", "认同观点", "价值观匹配"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_010",
      "round": 4,
      "purpose": "深入了解-未来规划",
      "user_emotion": ["感兴趣", "期待"],
      "coach_style": ["鼓励型"],
      "level": "规划型",
      "text": "聊了这么多，我想问问你对未来有什么规划吗？比如在事业或者生活方面，你有什么理想或者目标吗？",
      "tags": ["深入了解", "未来规划", "价值观探讨"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_011",
      "round": 4,
      "purpose": "深入了解-感情观",
      "user_emotion": ["平静"],
      "coach_style": ["分析型"],
      "level": "坦诚型",
      "text": "既然是相亲，我觉得我们可以坦诚一点。你觉得两个人在一起最重要的是什么？或者说，你理想中的伴侣是什么样的？",
      "tags": ["深入了解", "感情观", "坦诚沟通"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_012",
      "round": 5,
      "purpose": "试探心意-直接型",
      "user_emotion": ["期待", "紧张"],
      "coach_style": ["支持型"],
      "level": "直接型",
      "text": "今天聊得特别开心，我想知道...你对我印象怎么样？就是那种不客套的真实想法。",
      "tags": ["试探心意", "直接询问", "展现真诚"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_013",
      "round": 5,
      "purpose": "试探心意-邀约型",
      "user_emotion": ["紧张", "期待"],
      "coach_style": ["鼓励型"],
      "level": "邀约型",
      "text": "我觉得今天特别聊得来，不知道你有没有兴趣，我们可以多接触几次。我知道附近有家咖啡店不错，要不要下次约一下？",
      "tags": ["试探心意", "邀约", "表达兴趣"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_014",
      "round": 6,
      "purpose": "收尾邀约-具体型",
      "user_emotion": ["开心", "期待"],
      "coach_style": ["支持型"],
      "level": "具体型",
      "text": "今天聊得特别愉快！我知道下个月有个XX活动，感觉你应该会感兴趣。要不我们加个联系方式，到时候一起去？",
      "tags": ["收尾邀约", "具体活动", "自然升级关系"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_015",
      "round": 6,
      "purpose": "收尾邀约-轻松型",
      "user_emotion": ["平静"],
      "coach_style": ["挑战型"],
      "level": "轻松型",
      "text": "今天认识你很开心！加个微信吧，以后常联系。说好了啊，下次你要带我去你说的那家店尝尝。",
      "tags": ["收尾邀约", "轻松自然", "约定下次"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_016",
      "round": 2,
      "purpose": "应对冷场-幽默解围",
      "user_emotion": ["尴尬"],
      "coach_style": ["鼓励型", "支持型"],
      "level": "幽默型",
      "text": "哎，好像突然冷场了...这是我第一次遇到这种情况有点紧张，要不我们聊聊美食？这个肯定不会冷场。",
      "tags": ["应对冷场", "幽默解围", "安全话题"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_017",
      "round": 3,
      "purpose": "化解尴尬-坦诚型",
      "user_emotion": ["尴尬"],
      "coach_style": ["支持型"],
      "level": "坦诚型",
      "text": "其实我刚才有点不知道说什么好，毕竟平时不太跟陌生人聊天。你别介意哈，咱们就当朋友随便聊就好。",
      "tags": ["化解尴尬", "坦诚", "拉近距离"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_018",
      "round": 2,
      "purpose": "回应赞美-谦虚型",
      "user_emotion": ["开心"],
      "coach_style": ["鼓励型"],
      "level": "谦虚型",
      "text": "谢谢夸奖！不过我觉得你也很优秀啊，刚才聊下来感觉你是个很有趣的人。",
      "tags": ["回应赞美", "谦虚", "回赞"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_019",
      "round": 3,
      "purpose": "表达欣赏-具体型",
      "user_emotion": ["感兴趣"],
      "coach_style": ["支持型"],
      "level": "具体型",
      "text": "我发现你说话特别有条理，而且思考问题的角度很独特，跟别人不太一样。这种独立思考的能力特别吸引人。",
      "tags": ["表达欣赏", "具体细节", "真诚赞美"],
      "usage_count": 0,
      "rating": 0
    },
    {
      "id": "xq_020",
      "round": 4,
      "purpose": "分享自己-引导互动",
      "user_emotion": ["平静", "期待"],
      "coach_style": ["分析型"],
      "level": "互动型",
      "text": "我平时喜欢做XX，周末经常会去XX。你呢？平时休息的时候喜欢做什么？我挺好奇你会怎么安排时间的。",
      "tags": ["分享自己", "引导互动", "展示生活"],
      "usage_count": 0,
      "rating": 0
    }
  ]
